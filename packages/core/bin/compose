#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloaders = [
    dirname(__DIR__, 3).'/vendor/autoload.php',
    dirname(__DIR__).'/vendor/autoload.php',
];

foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        (new Compose\Console\Application)->run();

        exit;
    }
}

fwrite(STDERR, "Compose dependencies are not installed. Run composer install.\n");
exit(1);
