{
    "name": "compose/compose",
    "description": "Typed, composable automation for PHP projects.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nikic/php-parser": "^5.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/console": "^7.3|^8.0",
        "symfony/process": "^7.3|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Compose\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "bin": [
        "bin/compose"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
